#!/usr/bin/env bash
# Builds the dashboard frontend into frontend/dist (embedded by the Rust
# server), then the release binary. The source is frontend/app/frontend.
#
# URL /vite/<file> is served from frontend/dist/<file>; the entrypoints are
# looked up in frontend/dist/.vite/manifest.json.
set -euo pipefail

NODE=node@22.23.2
PNPM=pnpm@10.30.3

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
frontend="$root/frontend"

# mise pins the versions locally; CI (setup-node + corepack) has them on PATH.
if command -v mise > /dev/null; then run() { mise exec "$NODE" "$PNPM" -- "$@"; }; else run() { "$@"; }; fi

# 1. Vite build.
(cd "$frontend" && run pnpm install --frozen-lockfile && run pnpm exec vite build)

# 2. Precompressed siblings for the server to pick by Accept-Encoding.
# -n keeps names and timestamps out of the gzip header, so output is stable.
find "$frontend/dist" -type f -size +1024c \
  \( -name '*.js' -o -name '*.css' -o -name '*.svg' -o -name '*.json' \
     -o -name '*.html' -o -name '*.txt' -o -name '*.map' \) \
  -not -path "$frontend/dist/.vite/*" -print0 |
  while IFS= read -r -d '' file; do
    gzip -9 -n -k -f "$file"
    brotli -q 11 -k -f "$file"
  done

# 3. The server binary, which embeds frontend/dist.
if [ "${SKIP_CARGO:-}" != 1 ]; then
  (cd "$root" && cargo build --release -p railwatch-server)
fi
