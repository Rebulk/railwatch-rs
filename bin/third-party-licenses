#!/usr/bin/env bash
# Writes THIRD-PARTY-LICENSES: the notices for everything in a release
# tarball that is not this repository's own code, which bin/release copies
# into every tarball next to LICENSE (AGPL-3.0-only).
#
#   bin/third-party-licenses           rewrite THIRD-PARTY-LICENSES
#   bin/third-party-licenses --check   fail if it is out of date (CI)
#
# Sections:
#   1. code ported into this repository (named in each file's SPDX header);
#   2. the railwatch gem, whose app/frontend is built into the dashboard;
#   3. the npm packages Vite bundles into frontend/dist (production deps);
#   4. every Rust crate linked into the binary on the release targets
#      (cargo-about, about.toml), C libraries they compile in included.
#
# Needs: cargo-about (cargo install --locked --features cli cargo-about),
# frontend/node_modules (bin/build), the gem's .gem in frontend/tmp/gems.
set -euo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
out="$root/THIRD-PARTY-LICENSES"
tmp="$(mktemp -d)"
trap 'rm -rf "$tmp"' EXIT

command -v cargo-about > /dev/null || { echo "bin/third-party-licenses: needs cargo-about (cargo install --locked --features cli cargo-about)" >&2; exit 1; }
[ -d "$root/frontend/node_modules" ] || { echo "bin/third-party-licenses: frontend/node_modules is missing (bin/build)" >&2; exit 1; }
gem_file=$(ls "$root"/frontend/tmp/gems/railwatch-*.gem 2> /dev/null | head -1)
[ -n "$gem_file" ] || { echo "bin/third-party-licenses: the railwatch .gem is missing (bin/build fetches it)" >&2; exit 1; }

# 4. Rust crates. {{{ }}}: the texts are plain text, not HTML.
cat > "$tmp/crates.hbs" <<'EOF'
{{#each licenses}}
--------------------------------------------------------------------------------
{{{name}}} ({{{id}}}), used by:
{{#each used_by}}  {{{crate.name}}} {{{crate.version}}}
{{/each}}
{{{text}}}
{{/each}}
EOF
(cd "$root" && cargo-about about generate --offline --fail -m crates/server/Cargo.toml "$tmp/crates.hbs" -o "$tmp/crates.txt" 2> "$tmp/about.log") \
  || { cat "$tmp/about.log" >&2; exit 1; }

# 3. npm packages bundled into the frontend: each with its own license file.
(cd "$root/frontend" && pnpm licenses list --prod --json) > "$tmp/npm.json"
# 2. the gem's MIT-LICENSE, straight from the pinned .gem.
tar -xOf "$gem_file" data.tar.gz | tar -xzO MIT-LICENSE > "$tmp/gem-license.txt"

python3 -I - "$root" "$tmp" "$(basename "$gem_file" .gem)" > "$tmp/out" <<'PY'
import json, pathlib, sys
root, tmp, gem = pathlib.Path(sys.argv[1]), pathlib.Path(sys.argv[2]), sys.argv[3]
rule = "=" * 80
def section(title):
    print(f"\n{rule}\n{title}\n{rule}")

print("""THIRD-PARTY SOFTWARE NOTICES

Railwatch (railwatch-rs) is licensed under the GNU Affero General Public
License, version 3 only (LICENSE). Its source: https://github.com/Rebulk/railwatch-rs

It contains, or is built from, the third-party works below, each under its
own license. Generated by bin/third-party-licenses; do not edit by hand.""")

section("1. Code ported into this repository")
print("""
Each file's header names its origin; the full notices follow.

crates/server/src/rollup/random.rs: MT19937 from Ruby's missing/mt19937.c
  Copyright (C) 1997 - 2002, Makoto Matsumoto and Takuji Nishimura. BSD-3-Clause
  (the notice is reproduced in full in that file's header).
crates/server/src/rollup/random.rs, crates/server/src/rjson/parse.rs:
  behaviour of Ruby (array.c, random.c) and the json gem 2.21.2 parser.
  Copyright (C) 1993-2013 Yukihiro Matsumoto. BSD-2-Clause:""")
print("""
  Redistribution and use in source and binary forms, with or without
  modification, are permitted provided that the following conditions
  are met:
  1. Redistributions of source code must retain the above copyright
     notice, this list of conditions and the following disclaimer.
  2. Redistributions in binary form must reproduce the above copyright
     notice, this list of conditions and the following disclaimer in the
     documentation and/or other materials provided with the distribution.

  THIS SOFTWARE IS PROVIDED BY THE AUTHOR AND CONTRIBUTORS ``AS IS'' AND
  ANY EXPRESS OR IMPLIED WARRANTIES, INCLUDING, BUT NOT LIMITED TO, THE
  IMPLIED WARRANTIES OF MERCHANTABILITY AND FITNESS FOR A PARTICULAR PURPOSE
  ARE DISCLAIMED.  IN NO EVENT SHALL THE AUTHOR OR CONTRIBUTORS BE LIABLE
  FOR ANY DIRECT, INDIRECT, INCIDENTAL, SPECIAL, EXEMPLARY, OR CONSEQUENTIAL
  DAMAGES (INCLUDING, BUT NOT LIMITED TO, PROCUREMENT OF SUBSTITUTE GOODS
  OR SERVICES; LOSS OF USE, DATA, OR PROFITS; OR BUSINESS INTERRUPTION)
  HOWEVER CAUSED AND ON ANY THEORY OF LIABILITY, WHETHER IN CONTRACT, STRICT
  LIABILITY, OR TORT (INCLUDING NEGLIGENCE OR OTHERWISE) ARISING IN ANY WAY
  OUT OF THE USE OF THIS SOFTWARE, EVEN IF ADVISED OF THE POSSIBILITY OF
  SUCH DAMAGE.

crates/server/src/rjson/fpconv.rs: fpconv_dtoa (https://github.com/night-shift/fpconv,
  as vendored in Ruby's json gem). Boost Software License 1.0 (reproduced in
  full in that file's header).
""")
mit = """  Permission is hereby granted, free of charge, to any person obtaining a copy
  of this software and associated documentation files (the "Software"), to deal
  in the Software without restriction, including without limitation the rights
  to use, copy, modify, merge, publish, distribute, sublicense, and/or sell
  copies of the Software, and to permit persons to whom the Software is
  furnished to do so, subject to the following conditions:

  The above copyright notice and this permission notice shall be included in
  all copies or substantial portions of the Software.

  THE SOFTWARE IS PROVIDED "AS IS", WITHOUT WARRANTY OF ANY KIND, EXPRESS OR
  IMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY,
  FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL THE
  AUTHORS OR COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER
  LIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING FROM,
  OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN
  THE SOFTWARE."""
print("crates/server/src/rollup/tdigest.rs: the tdigest gem 0.2.1 (\"tdigest\").\n  Copyright (c) 2015 Sebastian Wallin. MIT:\n")
print(mit)
print("\ncrates/server/src/jobs/schedule.rs: fugit 1.11's schedule grammar (\"fugit\").\n  Copyright (c) 2017-2024 John Mettraux. MIT:\n")
print(mit)

section(f"2. The railwatch gem ({gem}): app/frontend is built into the dashboard")
print()
print((tmp / "gem-license.txt").read_text().rstrip())

section("3. npm packages bundled into the dashboard (frontend/dist)")
npm = json.loads((tmp / "npm.json").read_text())
pkgs = sorted(((p["name"], v, p["license"], path) for lic in npm.values() for p in lic for v, path in zip(p["versions"], p["paths"])), key=lambda t: (t[0], t[1]))
for name, version, lic, path in pkgs:
    d = pathlib.Path(path)
    files = sorted(f for f in d.iterdir() if f.is_file() and f.name.upper().startswith(("LICENSE", "LICENCE", "COPYING", "NOTICE")))
    print(f"\n--------------------------------------------------------------------------------\n{name} {version} ({lic})")
    if files:
        for f in files:
            print()
            print(f.read_text(errors="replace").rstrip())
    else:
        print(f"\n  (the package ships no license file; its package.json declares {lic})")

section("4. Rust crates linked into the railwatch binary (x86_64 and aarch64 musl)")
print("""
Includes the C libraries those crates compile in: SQLite (public domain, via
libsqlite3-sys), zlib (Zlib, via libz-sys), zstd (BSD-3-Clause, via
zstd-sys), mimalloc (MIT, via libmimalloc-sys), and ring's BoringSSL-derived
code (ISC and OpenSSL-style notices, in ring's license below).
inertia-omega (git, github.com/cole-robertson/inertia-omega) declares MIT in
its Cargo.toml and ships no license file, so the MIT text below stands in.""")
print((tmp / "crates.txt").read_text().rstrip())
PY

if [ "${1:-}" = --check ]; then
  cmp -s "$tmp/out" "$out" || { echo "THIRD-PARTY-LICENSES is out of date: run bin/third-party-licenses" >&2; diff <(head -c 2000 "$out") <(head -c 2000 "$tmp/out") | head -20 >&2; exit 1; }
  echo "THIRD-PARTY-LICENSES is up to date"
else
  mv "$tmp/out" "$out"
  echo "wrote $out ($(wc -l < "$out") lines)"
fi
